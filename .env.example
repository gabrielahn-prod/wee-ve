# Weeve 웹 — 환경변수 예시
# 이 파일을 복사해서 config.js에 값을 채워 넣으세요.
# (이 프로젝트는 빌드 툴 없는 정적 HTML이므로 로컬에서는 실제 .env 대신 config.js를 사용합니다.
#  Vercel에 배포할 때는 아래 값들을 프로젝트 환경변수로 등록하면 build-config.js가 config.js를 자동 생성합니다.)

# ── Supabase ──────────────────────────────────────────────
# 콘솔 위치: supabase.com → 프로젝트 → Settings → API

SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...   # index.html / waitlist.html용 (공개 가능)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9... # admin.html 전용 (절대 노출 금지, api/에서만 사용)

# ── Admin 대시보드 비밀번호 ──────────────────────────────
ADMIN_PASSWORD=your_password_here
